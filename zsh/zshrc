# dotfiles zsh extras — sourced from the end of ~/.zshrc (after oh-my-zsh
# has already loaded). This file does NOT set ZSH_THEME/plugins/oh-my-zsh
# itself; that stays owned by the real ~/.zshrc.
#
# Resolves its own directory (following symlinks) so it works no matter
# where this repo is cloned — no more hardcoded ~/dotfiles path.
export ZSH_CONFIG="${${(%):-%x}:A:h}"

# Import zsh config files
source "$ZSH_CONFIG/aliases.zsh"
source "$ZSH_CONFIG/exports.zsh"

# Keep history
export HISTFILE="${HOME}/.zsh_history"
export HISTSIZE=1000
export SAVEHIST=100000
setopt hist_ignore_dups
setopt EXTENDED_HISTORY
setopt share_history

# back transition to directory (bd <name-of-parent-dir> / bd <n>)
source "$ZSH_CONFIG/plugins/bd/bd.zsh"

# zoxide (directory jump, replaces the old autojump/z setup)
if command -v zoxide >/dev/null 2>&1; then
  eval "$(zoxide init zsh)"
fi

# fzf (fuzzy history / file search, replaces peco)
if command -v fzf >/dev/null 2>&1; then
  source <(fzf --zsh)
fi

# Functions (zsh autoload: each file in functions/ defines a function
# named after the file — see `man zshmisc` "Alternate Loading" for how
# self-defining autoload files like these work)
fpath=("$ZSH_CONFIG/functions" $fpath)
for f in "$ZSH_CONFIG"/functions/*(N); do
  autoload -Uz "${f:t}"
done

LANG=en_US.UTF-8
